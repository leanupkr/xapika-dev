# =============================================================================
# Xapika Engineering — Environment Variables (template)
# =============================================================================
# Copy this file to `.env.local` (Git-ignored) and fill in the values.
# All variables are optional in development; the site runs without them but
# loses some functionality. See README.md → "Environment Variables" for details.
# =============================================================================


# -----------------------------------------------------------------------------
# Site URL — used by sitemap, OG image, JSON-LD canonicals
# -----------------------------------------------------------------------------
# Defaults to https://xapika-dev.vercel.app when unset. Set to your preview /
# staging / production origin so absolute URLs resolve correctly.
#
# Vercel auto-injects VERCEL_URL but does NOT set this — set it explicitly in
# the Vercel project's "Environment Variables" panel.

NEXT_PUBLIC_SITE_URL=https://xapika-dev.vercel.app


# -----------------------------------------------------------------------------
# Resend — Contact form email delivery
# -----------------------------------------------------------------------------
# 1) Create a Resend API key:    https://resend.com/api-keys
# 2) Verify the sending domain (xapika.co.kr) in Resend, configure SPF / DKIM DNS.
# 3) Fill in the values below.
#
# Without RESEND_API_KEY the contact form still works — submissions are
# accepted and validated, but no email is delivered (the server logs them).

RESEND_API_KEY=

# Sender shown in the recipient inbox. Must be on a domain you've verified in
# Resend, otherwise delivery will fail. Default falls back to a non-routable
# placeholder so missing config doesn't crash the build.
CONTACT_FROM_EMAIL="Xapika Contact <noreply@xapika.co.kr>"

# Where contact form submissions are delivered. Receiving stays on the existing
# xapika.pl inbox; only the sending domain moved to xapika.co.kr.
CONTACT_TO_EMAIL=info@xapika.pl

# Optional CC. Leave blank to disable.
CONTACT_CC_EMAIL=


# -----------------------------------------------------------------------------
# Sanity — News CMS (Studio at /studio, content at /news)
# -----------------------------------------------------------------------------
# The Sanity project is created manually by info@xapika.pl at sanity.io — it
# is NOT created by this codebase and there is no CLI command in this repo
# that provisions it. See NEWS_CMS_PLAN.md §10 (Day 1) for the walkthrough.
#
# Until NEXT_PUBLIC_SANITY_PROJECT_ID is set, the site still builds and runs
# fine — /news, the homepage news preview, and /news/rss.xml simply render
# an empty state instead of erroring (see src/sanity/env.ts).

# From sanity.io/manage → the project → Project ID (8-character alphanumeric,
# e.g. "abc12345"). Shown on the project's overview page.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# The dataset created alongside the project. This codebase hardcodes the
# assumption that it is named exactly "production" — do not create the
# Sanity dataset under a different name.
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the Sanity → this site webhook that clears the page
# cache the moment an article is published/edited/deleted (see
# src/app/api/revalidate/route.ts). Generate with:
#   openssl rand -hex 32
# Paste the same value into both this file (for local testing) and the
# webhook's "Secret" field in sanity.io/manage → API → Webhooks. Without
# this set, the revalidate endpoint responds 401 and refuses all requests
# rather than accepting unverified webhook calls.
SANITY_REVALIDATE_SECRET=


# -----------------------------------------------------------------------------
# Analytics & Monitoring (placeholders — not yet wired into the codebase)
# -----------------------------------------------------------------------------
# Vercel Analytics + Speed Insights are mounted automatically when the project
# is deployed on Vercel — no key needed.
#
# The variables below are reserved for future integrations referenced in the
# PRD. They are currently NOT consumed by any code path; setting them has no
# effect until the corresponding integration ships.

# Sentry (error monitoring) — pending integration
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics 4 — pending integration
# NEXT_PUBLIC_GA4_ID=

# reCAPTCHA v3 (contact form) — pending integration
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
